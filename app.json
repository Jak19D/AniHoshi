{
  "expo": {
    "name": "AniHoshi",
    "slug": "AniHoshi",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.anihoshi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0F1D"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F1D",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-video",
      "expo-image"
    ]
  }
}
